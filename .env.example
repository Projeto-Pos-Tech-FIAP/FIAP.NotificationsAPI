# Copie este arquivo para ".env" (que fica fora do git).
#
# Se voce SO vai desenvolver/rodar as outras APIs (Catalog/Users/Payment) e nao
# vai mexer na Lambda/tunel: nao precisa mudar nada aqui, nem gerar
# certificado nenhum. `cp .env.example .env` ja e suficiente — o Kafka sobe
# normalmente usando um certificado de exemplo versionado no repo
# (kafka-certs-default/), so o listener TUNNEL fica inerte (ninguem consegue
# autenticar nele, mas isso nao afeta os outros listeners).
#
# Se voce VAI mexer na Lambda/tunel (ver README, secao "Migracao serverless"):
#   1. Rode `ngrok tcp 9094` e copie o endereco "Forwarding" (sem o "tcp://").
#   2. Rode `./generate-kafka-tunnel-certs.sh <endereco-do-tunnel-sem-porta>`
#      (ex: ./generate-kafka-tunnel-certs.sh 0.tcp.sa.ngrok.io)
#   3. Preencha os 4 valores abaixo com o que o script imprimir.

# Pasta com os certificados que o Kafka vai usar no listener TUNNEL.
# Deixe como está (kafka-certs-default) se não for mexer na Lambda.
# Depois de rodar o generate-kafka-tunnel-certs.sh, troque para: ./kafka-certs
KAFKA_CERTS_DIR=./kafka-certs-default

# Endereço completo (host:porta) que o ngrok mostrou no "Forwarding"
TUNNEL_ADVERTISED_ADDRESS=localhost:9094

# Senha do usuário SASL "lambda" usado pela AWS Lambda pra autenticar no Kafka
KAFKA_TUNNEL_SASL_PASSWORD=kafka-tunnel-default-pass

# Senha do keystore/chave TLS gerados por generate-kafka-tunnel-certs.sh
KAFKA_TUNNEL_KEYSTORE_PASSWORD=kafka-tunnel-default-pass
